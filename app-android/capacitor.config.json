{
  "appId": "it.radiciapp.prenota",
  "appName": "Radici",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#6E7A3C"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com",
        "apple.com"
      ]
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "alert",
        "badge",
        "sound"
      ]
    }
  },
  "ios": {
    "backgroundColor": "#6E7A3C",
    "contentInset": "never",
    "scheme": "Radici"
  },
  "experimental": {
    "ios": {
      "spm": {
        "swiftToolsVersion": "6.1",
        "packageTraits": {
          "@capacitor-firebase/authentication": [
            "Google"
          ]
        },
        "packageOptions": {
          "@capacitor-firebase/authentication": {
            "symlink": true
          },
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        }
      }
    }
  }
}
