{
  "appId": "it.radiciapp.prenota",
  "appName": "Radici",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#6E7A3C"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "alert",
        "badge",
        "sound"
      ]
    }
  }
}
